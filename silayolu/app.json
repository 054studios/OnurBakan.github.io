{
  "expo": {
    "name": "Silayolu",
    "slug": "silayolu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C4390A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.silayolu.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Silayolu profil fotoğrafı için kamera erişimi istiyor.",
        "NSMicrophoneUsageDescription": "Walkie-talkie sesli iletişim voor mikrofon erişimi istiyor.",
        "UIBackgroundModes": ["audio", "remote-notification"]
      }
    },
    "android": {
      "package": "com.silayolu.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C4390A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "silayolu",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C4390A",
          "defaultChannel": "border-alerts",
          "sounds": []
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ]
    ]
  }
}
